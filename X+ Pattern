import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();   // example: 1234567
        int n = s.length();
        int mid = n / 2;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (i == j || i + j == n - 1 || i == mid || j == mid)
                    System.out.print(s.charAt(j) + " ");
                else
                    System.out.print("  ");

            }
            System.out.println();
        }
    }
}
